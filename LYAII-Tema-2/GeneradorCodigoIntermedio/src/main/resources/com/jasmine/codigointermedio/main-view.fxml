<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #FFF5F8;" xmlns="http://javafx.com/javafx/23.0.2"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jasmine.codigointermedio.MainController">


    <top>

        <VBox>

            <MenuBar style="-fx-background-color: #F8C8D8;
            -fx-padding: 4px 10px 4px 10px;">

                <Menu style="-fx-text-fill: #5A3A45;" text="Archivo">

                    <MenuItem onAction="#limpiar" text="Limpiar"/>

                </Menu>

                <Menu style="-fx-text-fill: #5A3A45;" text="Representaciones">

                    <MenuItem text="Prefija"/>
                    <MenuItem text="Infija"/>
                    <MenuItem text="Postfija"/>
                    <MenuItem text="Notación Polaca"/>
                    <MenuItem text="Código P"/>
                    <MenuItem text="Triplos"/>
                    <MenuItem text="Cuádruplos"/>

                </Menu>

            </MenuBar>


            <VBox style="-fx-background-color: #F3AFC4;
            -fx-padding: 20px 25px 20px 25px;">

                <Label style="-fx-text-fill: #4A2935;
                -fx-font-size: 26px;
                -fx-font-weight: bold;"
                       text="GENERADOR DE CÓDIGO INTERMEDIO"/>

                <Label style="-fx-text-fill: #704957;
                -fx-font-size: 14px;
                -fx-padding: 5px 0 0 0;"
                       text="Analiza y convierte expresiones fácilmente"/>

            </VBox>

        </VBox>

    </top>

    <center>

        <HBox spacing="20" style="-fx-padding: 25px;">


            <VBox spacing="14"
                  style="-fx-background-color: white;
                  -fx-background-radius: 15px;
                  -fx-border-color: #F3B5C9;
                  -fx-border-radius: 15px;
                  -fx-border-width: 2px;
                  -fx-padding: 25px;"
                  HBox.hgrow="ALWAYS">

                <Label style="-fx-text-fill: #C45A7A;
                -fx-font-size: 22px;
                -fx-font-weight: bold;"
                       text="Entrada"/>

                <Label style="-fx-text-fill: #654550;
                -fx-font-size: 14px;"
                       text="Escribe la expresión que deseas convertir:"/>


                <TextField fx:id="txtExpresion" promptText="Ejemplo: a = b + c * d"
                           style="-fx-background-color: #FFF8FA;
                           -fx-border-color: #E8A5BB;
                           -fx-border-radius: 8px;
                           -fx-background-radius: 8px;
                           -fx-padding: 10px;
                           -fx-font-size: 15px;"/>


                <Label style="-fx-text-fill: #654550;
                -fx-font-size: 14px;"
                       text="Representación"/>


                <ComboBox fx:id="cbRepresentacion" maxWidth="Infinity"
                          style="-fx-background-color: #FFF8FA;
                          -fx-border-color: #E8A5BB;
                          -fx-border-radius: 8px;
                          -fx-background-radius: 8px;
                          -fx-font-size: 14px;"/>


                <Button maxWidth="Infinity" onAction="#convertir"
                        style="-fx-background-color: #EFA9C0;
                        -fx-text-fill: white;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10px;
                        -fx-padding: 11px;
                        -fx-cursor: hand;"
                        text=" Convertir expresión"/>


                <Button maxWidth="Infinity" onAction="#limpiar"
                        style="-fx-background-color: #FCE1EA;
                        -fx-text-fill: #A64F6B;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10px;
                        -fx-padding: 10px;
                        -fx-cursor: hand;"
                        text="Limpiar"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Label style="-fx-text-fill: #9B7180;
                -fx-font-size: 12px;"
                       text="Tip: prueba con a = b + c * d" wrapText="true"/>

            </VBox>


            <!-- PANEL DE RESULTADO -->


            <VBox spacing="14"
                  style="-fx-background-color: #FFFDFE;
                  -fx-background-radius: 15px;
                  -fx-border-color: #F3B5C9;
                  -fx-border-radius: 15px;
                  -fx-border-width: 2px;
                  -fx-padding: 25px;"
                  HBox.hgrow="ALWAYS">

                <Label style="-fx-text-fill: #C45A7A;
                -fx-font-size: 22px;
                -fx-font-weight: bold;"
                       text="Resultado"/>


                <Label style="-fx-text-fill: #765361;
                -fx-font-size: 14px;"
                       text="Aquí aparecerá la conversión de tu expresión"/>


                <TextArea fx:id="areaResultado" editable="false" promptText="El resultado aparecerá aquí..."
                          style="-fx-control-inner-background: #FFF8FA;
                          -fx-background-color: #FFF8FA;
                          -fx-border-color: #E8A5BB;
                          -fx-border-radius: 10px;
                          -fx-background-radius: 10px;
                          -fx-font-size: 16px;
                          -fx-padding: 12px;"
                          wrapText="true" VBox.vgrow="ALWAYS"/>

            </VBox>


        </HBox>

    </center>


    <bottom>

        <HBox style="-fx-background-color: #F8C8D8;
        -fx-padding: 10px 20px 10px 20px;">


            <Region HBox.hgrow="ALWAYS"/>

            <Label style="-fx-text-fill: #C45A7A;
            -fx-font-size: 16px;"/>

        </HBox>

    </bottom>

</BorderPane>
