<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cynthiasystems.generaciondecodigointermedio.memoria.MemoriaController">
    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <Label text="Administración de memoria" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label wrapText="true"
                   text="La memoria principal es un arreglo lineal de localidades de un byte, cada&#10;una con una dirección que la identifica. Las variables de tu expresión ya&#10;se reservaron automáticamente; también puedes asignar otras, liberarlas&#10;o simular un recolector de basura que limpia lo que ya no se usa."/>

            <FlowPane fx:id="cuadricula" hgap="4" vgap="4" prefWrapLength="520"/>

            <HBox spacing="10">
                <TextField fx:id="campoVariable" promptText="nombre variable" prefWidth="110"/>
                <TextField fx:id="campoTamanio" promptText="tamaño (bytes)" prefWidth="110"/>
                <Button text="Asignar" onAction="#asignar"/>
                <Button text="Liberar" onAction="#liberar"/>
            </HBox>

            <Button text="Simular recolector de basura" onAction="#recolectarBasura"/>

            <Label wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #666;"
                   text="Para el recolector: escribe en 'nombre variable' las variables vivas separadas por comas (vacío = ninguna viva)."/>

            <Label fx:id="etiquetaEstado"/>
        </VBox>
    </center>
    <bottom>
        <Button text="Finalizar (volver a inicio)" onAction="#finalizar">
            <BorderPane.margin>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </BorderPane.margin>
        </Button>
    </bottom>
</BorderPane>
