<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cynthiasystems.generaciondecodigointermedio.EntradaController">
    <padding>
        <Insets top="60" right="60" bottom="60" left="60"/>
    </padding>

    <Label text="Compilador"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" wrapText="true"/>
    <Label wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #666;"
           text="Escribe una expresión aritmética como código fuente"/>

    <TextField fx:id="campoExpresion" text="a + b * c - d" prefWidth="360"
               style="-fx-font-family: monospace; -fx-font-size: 14px;"/>

    <Button text="Compilar ->" onAction="#compilar" minWidth="180" minHeight="40"/>

    <Label fx:id="etiquetaError" style="-fx-text-fill: #d33;" wrapText="true"/>
</VBox>
