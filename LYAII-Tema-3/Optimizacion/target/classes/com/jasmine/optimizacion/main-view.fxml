<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #F8F3FF;" xmlns="http://javafx.com/javafx/23.0.2"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jasmine.optimizacion.MainController">

    <top>
        <VBox>
            <VBox spacing="4" style="-fx-background-color: #CDB4EA; -fx-padding: 20px 25px;">
                <Label style="-fx-text-fill: #3F3150; -fx-font-size: 27px; -fx-font-weight: bold;"
                       text="OPTIMIZADOR DE CÓDIGO"/>
                <Label style="-fx-text-fill: #655476; -fx-font-size: 14px;"
                       text="Analiza y mejora código de manera sencilla"/>
            </VBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 25px;">

            <VBox spacing="13"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 16px;
                  -fx-border-color: #D7BFF0; -fx-border-radius: 16px;
                  -fx-border-width: 2px; -fx-padding: 25px;"
                  HBox.hgrow="ALWAYS">

                <Label style="-fx-text-fill: #8055A8; -fx-font-size: 22px; -fx-font-weight: bold;"
                       text="Código de entrada"/>
                <Label style="-fx-text-fill: #5D5068; -fx-font-size: 14px;"
                       text="Escribe las instrucciones que deseas analizar:"/>

                <TextArea fx:id="areaEntrada" promptText="Ejemplo:&#10;x = 2 + 3 * 4&#10;y = x * 1&#10;z = y + 0"
                          style="-fx-control-inner-background: #FCF9FF; -fx-background-color: #FCF9FF;
                          -fx-border-color: #D7BFF0; -fx-border-radius: 10px;
                          -fx-background-radius: 10px; -fx-font-size: 15px; -fx-padding: 12px;"
                          wrapText="true" VBox.vgrow="ALWAYS"/>

                <Label style="-fx-text-fill: #5D5068; -fx-font-size: 14px;" text="Tipo de optimización"/>

                <ComboBox fx:id="cbOptimizacion" maxWidth="Infinity"
                          style="-fx-background-color: #FCF9FF; -fx-border-color: #D7BFF0;
                          -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 14px;"/>

                <Button maxWidth="Infinity" onAction="#optimizar"
                        style="-fx-background-color: #B995D6; -fx-text-fill: white;
                        -fx-font-size: 15px; -fx-font-weight: bold;
                        -fx-background-radius: 10px; -fx-padding: 11px;"
                        text=" Optimizar código"/>

                <Button maxWidth="Infinity" onAction="#limpiar"
                        style="-fx-background-color: #EADCF7; -fx-text-fill: #70458D;
                        -fx-font-size: 14px; -fx-font-weight: bold;
                        -fx-background-radius: 10px; -fx-padding: 10px;"
                        text="Limpiar"/>
            </VBox>

            <VBox spacing="13"
                  style="-fx-background-color: #FFFEFF; -fx-background-radius: 16px;
                  -fx-border-color: #D7BFF0; -fx-border-radius: 16px;
                  -fx-border-width: 2px; -fx-padding: 25px;"
                  HBox.hgrow="ALWAYS">

                <Label style="-fx-text-fill: #8055A8; -fx-font-size: 22px; -fx-font-weight: bold;" text="Resultado"/>
                <Label style="-fx-text-fill: #6E6079; -fx-font-size: 14px;"
                       text="Aquí aparecerá el resultado del análisis"/>

                <TextArea fx:id="areaResultado" editable="false" promptText="El resultado aparecerá aquí..."
                          style="-fx-control-inner-background: #FCF9FF; -fx-background-color: #FCF9FF;
                          -fx-border-color: #D7BFF0; -fx-border-radius: 10px;
                          -fx-background-radius: 10px; -fx-font-size: 15px; -fx-padding: 12px;"
                          wrapText="true" VBox.vgrow="ALWAYS"/>

                <Label style="-fx-text-fill: #5D5068; -fx-font-size: 14px;" text="Análisis de costo"/>
                <ComboBox fx:id="cbCosto" maxWidth="Infinity"
                          style="-fx-background-color: #FCF9FF; -fx-border-color: #D7BFF0;
                          -fx-border-radius: 8px; -fx-background-radius: 8px;"/>
                <Button maxWidth="Infinity" onAction="#analizarCosto"
                        style="-fx-background-color: #DCC8F2; -fx-text-fill: #65447B;
                        -fx-font-size: 14px; -fx-font-weight: bold;
                        -fx-background-radius: 10px; -fx-padding: 9px;"
                        text="Analizar costo"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #DCC8F2; -fx-padding: 10px 20px;">
            <Label style="-fx-text-fill: #665171; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>
